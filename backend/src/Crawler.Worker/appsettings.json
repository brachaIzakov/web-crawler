{
  "Urls": "http://+:8081",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=crawler;Username=crawler;Password=crawler"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "PrefetchCount": 1,
    "MaxRetries": 3,
    "RetryBaseDelaySeconds": 5
  },
  "Crawl": {
    "DefaultMaxPages": 200,
    "MaxDepthCap": 5,
    "MaxConcurrentFetches": 4,
    "ProgressFlushEveryPages": 5,
    "CancellationCheckEveryPages": 5,
    "FollowExternalLinks": false,
    "LeaseSeconds": 120,
    "AllowPrivateAddresses": false,
    "Http": {
      "TotalRequestTimeoutSeconds": 30,
      "AttemptTimeoutSeconds": 10,
      "MaxRetries": 3,
      "MaxRedirects": 5,
      "MaxConnectionsPerServer": 4
    },
    "UserAgent": "CrawlerBot/1.0"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
